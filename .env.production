# ============================================================
# Production environment – loaded by `next build` / `next start`
# with NODE_ENV=production (includes Vercel deployments).
# These values OVERRIDE the local `.env` during production builds.
# ============================================================

# NextAuth – vercel app URL (change if you add a custom domain)
NEXTAUTH_URL="https://fx-gym.vercel.app"
# Trust the host header so redirects (incl. sign-out) always point to
# https://fx-gym.vercel.app instead of localhost.
AUTH_TRUST_HOST="true"
# Strong randomly-generated secret – replace with your own in the Vercel dashboard
# (Settings → Environment Variables) if you prefer to keep it out of the repo.
NEXTAUTH_SECRET="f4d619e47ddd657ceb0c1f2035d21e2baae392d56b69a7a6c36c0d536c7073af26545bf56142a32354e23797a7222042"

# App
NEXT_PUBLIC_APP_URL="https://fx-gym.vercel.app"
NEXT_PUBLIC_APP_NAME="FX Gym"

EMAIL_FROM="FX Gym <ultimatereviewer24@gmail.com>"