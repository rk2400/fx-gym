generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  memberId      String?   @unique @map("member_id")
  otpCode       String?   @map("otp_code")
  otpExpires    DateTime? @map("otp_expires")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  phone                 String?
  weightKg              Float?   @map("weight_kg")
  heightCm              Float?   @map("height_cm")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  address               String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  checkins      Checkin[]
  auditLogs     AuditLog[]
  assignedTrainerId String? @map("assigned_trainer_id")
  assignedTrainer   User?  @relation("TrainerClients", fields: [assignedTrainerId], references: [id])
  clients         User[] @relation("TrainerClients")
  announcementsCreated Announcement[] @relation("AnnouncementsCreated")
  announcementReceipts AnnouncementRecipient[]
  invoices             Invoice[]

  @@index([email])
  @@index([memberId])
  @@index([role])
  @@index([assignedTrainerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model PricingPack {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  features    String[]
  isPopular   Boolean  @default(false) @map("is_popular")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  memberships Membership[]
}

model Membership {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricingPackId  String            @map("pricing_pack_id")
  pricingPack    PricingPack       @relation(fields: [pricingPackId], references: [id])
  startDate      DateTime          @default(now()) @map("start_date")
  endDate        DateTime          @map("end_date")
  status         MembershipStatus  @default(ACTIVE)
  stripeSubId    String?           @map("stripe_sub_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  invoices       Invoice[]
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique @map("invoice_number")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable + SetNull so invoice history survives a membership being deleted,
  // while the 1:1 link prevents duplicate invoices for the same term.
  membershipId  String?  @map("membership_id")
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  // Denormalised plan snapshot — invoices must stay accurate even if the
  // pricing pack is later edited or deleted.
  planName      String   @map("plan_name")
  issueDate     DateTime @default(now()) @map("issue_date")
  periodStart   DateTime? @map("period_start")
  periodEnd     DateTime? @map("period_end")
  subtotal      Decimal  @db.Decimal(10, 2)
  taxRatePct    Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate_pct")
  taxAmount     Decimal  @default(0) @db.Decimal(10, 2) @map("tax_amount")
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  status        String   @default("PAID") // PAID | PENDING | CANCELLED
  paymentMethod String?  @map("payment_method")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, issueDate])
}

model Checkin {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedIn DateTime @default(now()) @map("checked_in")
  checkedOut DateTime? @map("checked_out")
  type      String?  @map("workout_type")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text // Rich-text HTML body authored by the admin
  createdById String   @map("created_by_id")
  createdBy   User     @relation("AnnouncementsCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipients AnnouncementRecipient[]

  @@index([createdById])
  @@index([createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?    @map("read_at")
  emailSentAt    DateTime?    @map("email_sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      ContentType @default(TEXT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model OTPToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      OTPType
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, type])
  @@index([code])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model GymLocation {
  id          String   @id @default(cuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  radiusMeters Int     @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
}

enum Role {
  ADMIN
  MEMBER
  TRAINER
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ContentType {
  TEXT
  HTML
  JSON
  MARKDOWN
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
}
model GymSettings {
  id                String   @id @default("singleton")
  name              String
  legalName         String   @map("legal_name")
  tagline           String   @default("")
  addressLine1      String   @map("address_line1")
  addressLine2      String   @default("") @map("address_line2")
  phone             String
  email             String
  website           String
  gstEnabled        Boolean  @default(true) @map("gst_enabled")
  gstin             String   @default("")
  sac               String   @default("")
  gstRatePct        Decimal  @default(18.00) @db.Decimal(5, 2) @map("gst_rate_pct")
  gstMode           String   @default("CGST_SGST") @map("gst_mode")
  placeOfSupply     String   @default("") @map("place_of_supply")
  upiId             String   @default("") @map("upi_id")
  invoiceFooterNote String   @default("") @map("invoice_footer_note")
  invoiceTerms      String   @default("") @map("invoice_terms")
  updatedAt         DateTime @updatedAt @map("updated_at")
}
