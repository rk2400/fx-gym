# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fx_gym?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# Email – SMTP works in local dev (Gmail app-password) but NOT on Vercel.
# For production use an HTTP provider (set in Vercel dashboard env vars):
#   EMAIL_RESEND_KEY="re_..."          # Resend (recommended)
#   EMAIL_BREVO_KEY="xkeysib-..."       # Brevo / Sendinblue
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@gmail.com"
EMAIL_SERVER_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="you@gmail.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FX Gym"